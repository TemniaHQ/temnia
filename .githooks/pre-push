#!/bin/sh
# Every push of a branch runs the exact-commit local gate unless HEAD already
# holds a receipt. Direct pushes to main and production are refused.
set -eu

zero=0000000000000000000000000000000000000000
head_sha=$(git rev-parse HEAD)
needs_gate=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/production)
      echo "Direct pushes to ${remote_ref#refs/heads/} are forbidden; open a pull request." >&2
      exit 1
      ;;
    refs/heads/*)
      if [ "$local_sha" = "$zero" ]; then
        continue
      fi
      if [ "$local_sha" != "$head_sha" ]; then
        echo "Refusing to push unvalidated $local_ref ($local_sha); checked-out HEAD is $head_sha." >&2
        exit 1
      fi
      needs_gate=1
      ;;
  esac
done

if [ "$needs_gate" -eq 1 ]; then
  exec pnpm ci:local -- --require-sha "$head_sha"
fi
