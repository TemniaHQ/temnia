# The Python worker's environment. Nothing loads this file: the worker reads
# os.environ, which comes from the shell locally and from Dokploy on staging
# (docs/runbooks/staging.md). It is here to document the shape, as
# apps/web/.env.example does for the app.

# Temporal server (compose.yaml exposes the dev server on 56233).
TEMPORAL_ADDRESS=localhost:56233
TEMPORAL_NAMESPACE=default
# Must match TASK_QUEUES.pipeline in @temnia/contracts.
TEMPORAL_TASK_QUEUE=temnia-pipeline
# The same process serves short chapter controls on <TEMPORAL_TASK_QUEUE>-control.

# Product database, as the pipeline role. Never the owner: the pipeline runs no
# DDL and holds no BYPASSRLS.
PIPELINE_DATABASE_URL=postgres://temnia_pipeline:temnia_pipeline@localhost:56432/temnia

# Scratch space for masters and ladders, one directory per source.
PIPELINE_WORK_DIR=/tmp/temnia-pipeline

# Object storage (compose Garage locally; R2 on staging). No public endpoint
# here: the worker never signs a URL for a browser.
STORAGE_ENDPOINT=http://localhost:56900
STORAGE_REGION=garage
STORAGE_BUCKET=temnia-media
STORAGE_ACCESS_KEY_ID=GK746d6e696164657600000000
STORAGE_SECRET_ACCESS_KEY=7f5fbe4a561d5196e4422e7fe9b8b8880846f9e153aacd3a142fd3d27f8f2bd2

# Where the HLS ladder runs. `local` encodes with this container's ffmpeg and is
# the default for dev and the gate; `modal` spawns the deployed `ladder`
# function on an L4 and lets it publish to storage itself. On `modal` the worker
# refuses to boot unless the deployed app answers with the same contract
# version, so a wrong token or a stale deployment is a failed deploy.
TRANSCODE_BACKEND=local

# The deployed Modal app, and the Modal environment to look it up in. Leave the
# environment unset to use the workspace default; staging sets it to `staging`.
MODAL_APP=temnia-media
# MODAL_ENVIRONMENT=staging

# The Modal Dict the function writes stage and percent into while it works.
# Both sides must name the same one; entries expire after seven idle days.
MODAL_PROGRESS_DICT=temnia-ladder-progress

# Modal service-user tokens, read by the SDK. Only ever set where
# TRANSCODE_BACKEND=modal; they are secrets and never committed.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Transcription: recorded fixtures locally; modal preserves the original paired
# media deployment; modal-checkpointed opts into the separate temnia-speech app.
TRANSCRIPTION_PROVIDER=recorded
TRANSCRIPTION_RECORDINGS_DIR=tests/fixtures/transcripts
# TRANSCRIPTION_RECORDING=tests/fixtures/transcripts/speech-40s.whisperx.json
# MODAL_SPEECH_APP=temnia-speech
# MODAL_SPEECH_BUILD=<source build ID printed by the paired deployment>
# MODAL_SPEECH_PROTOCOL=temnia-speech/1
# Protocol temnia-speech/1 fixes its progress Dict as temnia-speech-progress;
# there is no worker-only override because reader and writer must stay paired.
# Protocol temnia-speech/2 is opt-in and uses temnia-speech-v2-progress. It also
# requires explicit JSON for MODAL_SPEECH_RESOURCE_PROFILE and
# MODAL_SPEECH_MODEL_MANIFEST, matched against the deployed identity at startup.
# Copy the verified identities from the deployment record, not example hashes.
# Production requires coalesced progress and a 3600-second stage limit; the
# 900-second and synchronous-control variants belong only to the benchmark CLI.
# SPEECH_EXECUTION_TOPOLOGY=parallel
# Deployment only: MODAL_SPEECH_V2_APP names a separate v2 app and
# MODAL_SPEECH_MODEL_VOLUME names a separately frozen read-only model volume.
# SPEECH_RUN_BUDGET_MICROS=6500000
# SPEECH_RATE_MICROS_PER_HOUR=1250000
# SPEECH_DISPATCH_LIMIT=5
# SPEECH_STAGE_TIMEOUT_SECONDS=3600
# SPEECH_STARTUP_TIMEOUT_SECONDS=120
# TEMNIA_MODELS_DIR=/opt/temnia-models

# Chapter harness. Both app and worker use 0/1 for these switches. Enabling it
# requires an explicit backend and a qualified immutable route snapshot. The
# snapshot ID is its canonical SHA-256, not a model name or a default vendor.
HARNESS_ENABLED=0
# HARNESS_BACKEND=gateway
# HARNESS_ROUTE_SNAPSHOT_ID=<canonical snapshot SHA-256>
# HARNESS_ROUTE_SNAPSHOT_PATH=/etc/temnia/harness-routes.json
HARNESS_ALLOW_RECORDED=0
# Recorded mode also requires an explicit synthetic fixture; it never calls a provider.
# HARNESS_RECORDED_FIXTURE_PATH=/etc/temnia/harness-recorded.json
HARNESS_MAX_RUN_BUDGET_MICROS=10000000
HARNESS_MAX_DISPATCHES=32
HARNESS_MAX_REPAIRS=1
HARNESS_MAX_OUTPUT_TOKENS=8192
HARNESS_EVIDENCE_WINDOW_SENTENCES=80
HARNESS_MAX_RENDER_CONCURRENCY=2
# Optional Chapter-Llama topic candidate for new editorial-policy runs (gateway backend).
# Use the complete frozen configuration printed by docs/plans/chapter-llama-integration.md.
# HARNESS_CHAPTER_LLAMA_CONFIG_JSON=<complete deployment configuration JSON>
# Worker only. Never put this credential in the web environment or a route file.
# AI_GATEWAY_API_KEY=
# Existing snapshots use Vercel when HARNESS_GATEWAY is absent. OpenRouter snapshots
# carry explicit transport/mode/deadline identity and require new qualification.
# HARNESS_GATEWAY=openrouter
# OPENROUTER_API_KEY=
