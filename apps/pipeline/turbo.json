{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "pyproject.toml",
        "uv.lock"
      ]
    },
    "typecheck": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "pyproject.toml",
        "uv.lock"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "pyproject.toml",
        "uv.lock"
      ],
      "env": [
        "HF_HOME",
        "HF_HUB_OFFLINE",
        "TEMNIA_MODELS_DIR",
        "TEMNIA_MODEL_TESTS",
        "TEMPORAL_ADDRESS",
        "TEMPORAL_NAMESPACE",
        "TEMPORAL_TASK_QUEUE",
        "TEST_DATABASE_URL",
        "TEST_PIPELINE_DATABASE_URL"
      ]
    }
  }
}
