# Temporal server (compose.yaml exposes the dev server on 56233).
TEMPORAL_ADDRESS=localhost:56233
TEMPORAL_NAMESPACE=default

# Product database, as the app role (compose creates it; never the owner).
DATABASE_URL=postgres://temnia_app:temnia_app@localhost:56432/temnia
# Owner connection for migrations only (pnpm --filter @temnia/db db:migrate).
MIGRATE_DATABASE_URL=postgres://temnia:temnia@localhost:56432/temnia

# Object storage (compose Garage locally; R2 on staging). The browser uploads
# parts straight to STORAGE_PUBLIC_ENDPOINT with server-signed URLs.
STORAGE_ENDPOINT=http://localhost:56900
STORAGE_PUBLIC_ENDPOINT=http://localhost:56900
STORAGE_REGION=garage
STORAGE_BUCKET=temnia-media
STORAGE_ACCESS_KEY_ID=GK746d6e696164657600000000
STORAGE_SECRET_ACCESS_KEY=7f5fbe4a561d5196e4422e7fe9b8b8880846f9e153aacd3a142fd3d27f8f2bd2
