# Temporal server (compose.yaml exposes the dev server on 56233).
TEMPORAL_ADDRESS=localhost:56233
TEMPORAL_NAMESPACE=default

# Product database, as the app role (compose creates it; never the owner).
DATABASE_URL=postgres://temnia_app:temnia_app@localhost:56432/temnia
# Owner connection for migrations only (pnpm --filter @temnia/db db:migrate).
MIGRATE_DATABASE_URL=postgres://temnia:temnia@localhost:56432/temnia

# Object storage (compose Garage locally; R2 on staging). The browser uploads
# parts straight to STORAGE_PUBLIC_ENDPOINT with server-signed URLs.
STORAGE_ENDPOINT=http://localhost:56900
STORAGE_PUBLIC_ENDPOINT=http://localhost:56900
STORAGE_REGION=garage
STORAGE_BUCKET=temnia-media
STORAGE_ACCESS_KEY_ID=GK746d6e696164657600000000
STORAGE_SECRET_ACCESS_KEY=7f5fbe4a561d5196e4422e7fe9b8b8880846f9e153aacd3a142fd3d27f8f2bd2

# Where the HLS ladder runs, and which engine transcribes. Both defaults stay
# on this machine: `local` and `recorded` never call a service that costs money,
# and there is no "unconfigured" state in which transcription silently does not
# happen. Staging sets `modal` for both (docs/runbooks/staging.md section 2c).
TRANSCODE_BACKEND=local
TRANSCRIPTION_PROVIDER=recorded
# Recorded WhisperX responses the `recorded` provider replays: either a
# directory, or one explicit file that wins over it. A directory is searched
# first by the audio's sha256 and then by the duration a recording declares in
# `_durationMs`, which is what lets three fixtures reach three different
# outcomes in one Playwright run (ready, retrying, failed) and does not move
# when ffmpeg is bumped. These two are read
# by the worker, not by this app, and a relative path resolves from the worker's
# own directory (`pnpm --filter @temnia/pipeline worker` runs in apps/pipeline),
# so the repository's fixtures are `tests/fixtures/transcripts`. The gate
# bind-mounts the same directory into the worker container.
TRANSCRIPTION_RECORDINGS_DIR=tests/fixtures/transcripts
# TRANSCRIPTION_RECORDING=tests/fixtures/transcripts/speech-40s.whisperx.json

# Chapter editing. Match these non-secret settings to the worker. A recorded
# backend requires explicit HARNESS_ALLOW_RECORDED=1, including on a laptop.
# Route files and the AI Gateway credential belong only on the worker.
HARNESS_ENABLED=0
# HARNESS_BACKEND=gateway
# HARNESS_ROUTE_SNAPSHOT_ID=<canonical snapshot SHA-256>
HARNESS_ALLOW_RECORDED=0
HARNESS_MAX_RUN_BUDGET_MICROS=10000000
HARNESS_MAX_DISPATCHES=32
HARNESS_MAX_REPAIRS=3
HARNESS_MAX_OUTPUT_TOKENS=8192
HARNESS_EVIDENCE_WINDOW_SENTENCES=80
HARNESS_MAX_RENDER_CONCURRENCY=2
