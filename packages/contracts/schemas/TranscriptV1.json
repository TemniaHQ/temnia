{
  "$defs": {
    "TranscriptProvider": {
      "$id": "#/$defs/TranscriptProvider",
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "name",
        "version"
      ],
      "additionalProperties": false,
      "title": "TranscriptProvider"
    },
    "TranscriptUtterance": {
      "$id": "#/$defs/TranscriptUtterance",
      "type": "object",
      "properties": {
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "endMs",
        "speaker",
        "startMs"
      ],
      "additionalProperties": false,
      "title": "TranscriptUtterance"
    },
    "TranscriptV1": {
      "$id": "#/$defs/TranscriptV1",
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "description": "The detected language code, so a wrong guess is visible."
        },
        "provider": {
          "$ref": "#/$defs/TranscriptProvider"
        },
        "speakers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every speaker id used by a word, in first-appearance order."
        },
        "utterances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptUtterance"
          }
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptWord"
          }
        }
      },
      "required": [
        "durationMs",
        "language",
        "provider",
        "speakers",
        "utterances",
        "version",
        "words"
      ],
      "additionalProperties": false,
      "title": "TranscriptV1"
    },
    "TranscriptWord": {
      "$id": "#/$defs/TranscriptWord",
      "type": "object",
      "properties": {
        "confidence": {
          "description": "Alignment score, or null when the provider gave none.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/WordTiming"
        }
      },
      "required": [
        "confidence",
        "endMs",
        "speaker",
        "startMs",
        "text",
        "timing"
      ],
      "additionalProperties": false,
      "title": "TranscriptWord"
    },
    "WordTiming": {
      "$id": "#/$defs/WordTiming",
      "type": "string",
      "enum": [
        "aligned",
        "interpolated"
      ],
      "title": "WordTiming"
    }
  },
  "$id": "TranscriptV1.json",
  "$ref": "#/$defs/TranscriptV1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
