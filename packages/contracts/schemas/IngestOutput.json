{
  "$defs": {
    "ArtifactKind": {
      "$id": "#/$defs/ArtifactKind",
      "type": "string",
      "enum": [
        "master",
        "hls",
        "peaks",
        "thumbnails",
        "audio",
        "shots"
      ],
      "title": "ArtifactKind"
    },
    "ArtifactRecord": {
      "$id": "#/$defs/ArtifactRecord",
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageKey": {
          "type": "string",
          "minLength": 1
        },
        "storagePrefix": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "contentType",
        "kind",
        "metadata",
        "sizeBytes",
        "storageKey",
        "storagePrefix"
      ],
      "additionalProperties": false,
      "title": "ArtifactRecord"
    },
    "IngestOutput": {
      "$id": "#/$defs/IngestOutput",
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRecord"
          }
        },
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "Echoed from the input scope, never invented."
        },
        "probe": {
          "$ref": "#/$defs/ProbeResult"
        },
        "processingSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Wall-clock seconds the worker spent."
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "storageBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Sum of the artifact rows written."
        }
      },
      "required": [
        "artifacts",
        "organizationId",
        "probe",
        "processingSeconds",
        "sourceId",
        "storageBytes"
      ],
      "additionalProperties": false,
      "title": "IngestOutput"
    },
    "ProbeResult": {
      "$id": "#/$defs/ProbeResult",
      "type": "object",
      "properties": {
        "audioChannels": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioCodec": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "variableFrameRate": {
          "type": "boolean"
        },
        "videoCodec": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "audioChannels",
        "audioCodec",
        "durationMs",
        "fps",
        "height",
        "sizeBytes",
        "variableFrameRate",
        "videoCodec",
        "width"
      ],
      "additionalProperties": false,
      "title": "ProbeResult"
    }
  },
  "$id": "IngestOutput.json",
  "$ref": "#/$defs/IngestOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
