{
  "$defs": {
    "ChapterRunOutput": {
      "$id": "#/$defs/ChapterRunOutput",
      "type": "object",
      "properties": {
        "editArtifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceArtifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "$ref": "#/$defs/HarnessRunStatus"
        }
      },
      "required": [
        "editArtifact",
        "errorMessage",
        "evidenceArtifact",
        "revision",
        "runId",
        "status"
      ],
      "additionalProperties": false,
      "title": "ChapterRunOutput"
    },
    "HarnessArtifactKind": {
      "$id": "#/$defs/HarnessArtifactKind",
      "type": "string",
      "enum": [
        "evidence",
        "proposal",
        "model_response",
        "edit",
        "render",
        "checks",
        "export",
        "speech_checkpoint",
        "speech_assignment"
      ],
      "title": "HarnessArtifactKind"
    },
    "HarnessArtifactRef": {
      "$id": "#/$defs/HarnessArtifactRef",
      "type": "object",
      "properties": {
        "fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/HarnessArtifactKind"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "fingerprint",
        "id",
        "kind",
        "sha256",
        "sizeBytes",
        "storageKey"
      ],
      "additionalProperties": false,
      "title": "HarnessArtifactRef"
    },
    "HarnessRunStatus": {
      "$id": "#/$defs/HarnessRunStatus",
      "type": "string",
      "enum": [
        "pending",
        "running",
        "needs_review",
        "ready",
        "budget_paused",
        "outcome_unknown",
        "failed",
        "cancelled"
      ],
      "title": "HarnessRunStatus"
    }
  },
  "$id": "ChapterRunOutput.json",
  "$ref": "#/$defs/ChapterRunOutput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
