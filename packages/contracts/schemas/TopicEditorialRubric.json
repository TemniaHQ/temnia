        },
        "viewerGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "assumedDomainKnowledge",
        "audienceDescription",
        "exclusions",
        "focus",
        "languagePolicy",
        "originalInstructions",
        "version",
        "viewerGoals"
