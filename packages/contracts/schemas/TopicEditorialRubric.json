          }
        },
        "audienceDescription": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "focus": {
          "type": "string"
        },
        "languagePolicy": {
          "type": "string",
          "minLength": 1
        },
        "originalInstructions": {
          "type": "string"
        },
        "version": {
