{
  "$defs": {
    "TopicInventorySection": {
      "$id": "#/$defs/TopicInventorySection",
      "type": "object",
      "properties": {
        "nextSectionId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ownershipSpan": {
          "$ref": "#/$defs/TopicSentenceSpan"
        },
        "previousSectionId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "sectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "nextSectionId",
        "ordinal",
        "ownershipSpan",
        "previousSectionId",
        "sectionId"
      ],
      "additionalProperties": false,
      "title": "TopicInventorySection"
    },
    "TopicOpportunityInventoryPlan": {
      "$id": "#/$defs/TopicOpportunityInventoryPlan",
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "topic-opportunity-inventory-plan/1"
        },
        "indexSha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "sections": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicInventorySection"
          }
        }
      },
      "required": [
        "format",
        "indexSha256",
        "sections"
      ],
      "additionalProperties": false,
      "title": "TopicOpportunityInventoryPlan"
    },
    "TopicSentenceSpan": {
      "$id": "#/$defs/TopicSentenceSpan",
      "type": "object",
      "properties": {
        "firstSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lastSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "firstSentenceId",
        "lastSentenceId"
      ],
      "additionalProperties": false,
      "title": "TopicSentenceSpan"
    }
  },
  "$id": "TopicOpportunityInventoryPlan.json",
  "$ref": "#/$defs/TopicOpportunityInventoryPlan",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
