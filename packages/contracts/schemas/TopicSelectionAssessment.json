{
  "$defs": {
    "HarnessArtifactKind": {
      "$id": "#/$defs/HarnessArtifactKind",
      "type": "string",
      "enum": [
        "evidence",
        "proposal",
        "model_response",
        "edit",
        "render",
        "checks",
        "export",
        "speech_checkpoint",
        "speech_assignment"
      ],
      "title": "HarnessArtifactKind"
    },
    "HarnessArtifactRef": {
      "$id": "#/$defs/HarnessArtifactRef",
      "type": "object",
      "properties": {
        "fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/HarnessArtifactKind"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "fingerprint",
        "id",
        "kind",
        "sha256",
        "sizeBytes",
        "storageKey"
      ],
      "additionalProperties": false,
      "title": "HarnessArtifactRef"
    },
    "TopicCriterion": {
      "$id": "#/$defs/TopicCriterion",
      "type": "object",
      "properties": {
        "evidenceSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        }
      },
      "required": [
        "evidenceSpans",
        "reason",
        "status"
      ],
      "additionalProperties": false,
      "title": "TopicCriterion"
    },
    "TopicOpportunity": {
      "$id": "#/$defs/TopicOpportunity",
      "type": "object",
      "properties": {
        "candidateIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completionSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "coreSpans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "disposition": {
          "type": "string",
          "enum": [
            "proposed",
            "not_useful_for_audience",
            "not_contiguously_extractable",
            "needs_evidence"
          ]
        },
        "dispositionReason": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "meaningChangingFollowups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "requiredContextSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "valueEvidenceSpans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "viewerPurpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "candidateIds",
        "completionSpans",
        "coreSpans",
        "disposition",
        "dispositionReason",
        "id",
        "meaningChangingFollowups",
        "requiredContextSpans",
        "valueEvidenceSpans",
        "viewerPurpose"
      ],
      "additionalProperties": false,
      "title": "TopicOpportunity"
    },
    "TopicOpportunityJudgment": {
      "$id": "#/$defs/TopicOpportunityJudgment",
      "type": "object",
      "properties": {
        "candidateIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceSpans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "opportunityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "represented",
            "missing_candidate",
            "duplicate_core",
            "not_useful_for_audience",
            "not_contiguously_extractable",
            "unresolved"
          ]
        }
      },
      "required": [
        "candidateIds",
        "evidenceSpans",
        "opportunityId",
        "reason",
        "status"
      ],
      "additionalProperties": false,
      "title": "TopicOpportunityJudgment"
    },
    "TopicPortfolioReview": {
      "$id": "#/$defs/TopicPortfolioReview",
      "type": "object",
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSourceJudgment"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSelectionFinding"
          }
        },
        "missingOpportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicOpportunity"
          }
        },
        "opportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicOpportunityJudgment"
          }
        },
        "selection": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSelectionDecision"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "candidates",
        "findings",
        "missingOpportunities",
        "opportunities",
        "selection",
        "summary"
      ],
      "additionalProperties": false,
      "title": "TopicPortfolioReview"
    },
    "TopicSelectionAssessment": {
      "$id": "#/$defs/TopicSelectionAssessment",
      "type": "object",
      "properties": {
        "coldReviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSelectionColdReview"
          }
        },
        "evidenceSha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "executionStatus": {
          "type": "string",
          "enum": [
            "complete",
            "needs_review",
            "execution_limited"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSelectionFinding"
          }
        },
        "format": {
          "type": "string",
          "const": "topic-selection-assessment/2"
        },
        "portfolioReview": {
          "anyOf": [
            {
              "$ref": "#/$defs/TopicPortfolioReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposerFamily": {
          "type": "string",
          "minLength": 1
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "responseArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HarnessArtifactRef"
          }
        },
        "rubricSha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "selectionSha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "verifierFamily": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "coldReviews",
        "evidenceSha256",
        "executionStatus",
        "findings",
        "format",
        "portfolioReview",
        "proposerFamily",
        "reasons",
        "responseArtifacts",
        "rubricSha256",
        "runId",
        "selectionSha256",
        "verifierFamily"
      ],
      "additionalProperties": false,
      "title": "TopicSelectionAssessment"
    },
    "TopicSelectionColdReview": {
      "$id": "#/$defs/TopicSelectionColdReview",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "coherentTopic": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "completeDiscussion": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "intelligibleBeginning": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "titleFaithful": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "value": {
          "$ref": "#/$defs/TopicValueReview"
        }
      },
      "required": [
        "candidateId",
        "coherentTopic",
        "completeDiscussion",
        "intelligibleBeginning",
        "titleFaithful",
        "value"
      ],
      "additionalProperties": false,
      "title": "TopicSelectionColdReview"
    },
    "TopicSelectionDecision": {
      "$id": "#/$defs/TopicSelectionDecision",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "disposition": {
          "type": "string",
          "enum": [
            "select",
            "decline",
            "unresolved"
          ]
        },
        "evidenceSpans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "candidateId",
        "disposition",
        "evidenceSpans",
        "reason"
      ],
      "additionalProperties": false,
      "title": "TopicSelectionDecision"
    },
    "TopicSelectionFinding": {
      "$id": "#/$defs/TopicSelectionFinding",
      "type": "object",
      "properties": {
        "affectedCandidateIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceSpans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "type": "string",
          "enum": [
            "missing_setup",
            "missing_qualification",
            "unfinished_discussion",
            "unsupported_title",
            "weak_viewer_value",
            "unfocused_extent",
            "duplicate_core",
            "missed_opportunity",
            "transcript_uncertainty",
            "physical_boundary_constraint"
          ]
        },
        "opportunityIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "required",
            "preference",
            "unknown"
          ]
        }
      },
      "required": [
        "affectedCandidateIds",
        "evidenceSpans",
        "id",
        "kind",
        "opportunityIds",
        "reason",
        "severity"
      ],
      "additionalProperties": false,
      "title": "TopicSelectionFinding"
    },
    "TopicSentenceSpan": {
      "$id": "#/$defs/TopicSentenceSpan",
      "type": "object",
      "properties": {
        "firstSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lastSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "firstSentenceId",
        "lastSentenceId"
      ],
      "additionalProperties": false,
      "title": "TopicSentenceSpan"
    },
    "TopicSourceJudgment": {
      "$id": "#/$defs/TopicSourceJudgment",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "completeContext": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "distinctPurpose": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "faithfulMeaning": {
          "$ref": "#/$defs/TopicCriterion"
        }
      },
      "required": [
        "candidateId",
        "completeContext",
        "distinctPurpose",
        "faithfulMeaning"
      ],
      "additionalProperties": false,
      "title": "TopicSourceJudgment"
    },
    "TopicValueReview": {
      "$id": "#/$defs/TopicValueReview",
      "type": "object",
      "properties": {
        "deliveredValue": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "focusedDevelopment": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "openingEffectiveness": {
          "$ref": "#/$defs/TopicCriterion"
        },
        "reconstructedPurpose": {
          "type": "string",
          "minLength": 1
        },
        "reconstructedTakeaway": {
          "type": "string",
          "minLength": 1
        },
        "viewerReasonToWatch": {
          "$ref": "#/$defs/TopicCriterion"
        }
      },
      "required": [
        "deliveredValue",
        "focusedDevelopment",
        "openingEffectiveness",
        "reconstructedPurpose",
        "reconstructedTakeaway",
        "viewerReasonToWatch"
      ],
      "additionalProperties": false,
      "title": "TopicValueReview"
    }
  },
  "$id": "TopicSelectionAssessment.json",
  "$ref": "#/$defs/TopicSelectionAssessment",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
