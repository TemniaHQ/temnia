          "minLength": 1,
          "maxLength": 256
        },
        "preview": {
          "type": "string"
        },
        "sentenceCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "childIds",
        "embedding",
        "endMs",
        "firstSentenceId",
        "id",
        "keywords",
        "kind",
        "lastSentenceId",
        "ordinal",
        "parentId",
        "preview",
        "sentenceCount",
        "startMs"
