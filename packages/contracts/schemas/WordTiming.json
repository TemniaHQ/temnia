{
  "$defs": {
    "ArtifactKind": {
      "$id": "#/$defs/ArtifactKind",
      "type": "string",
      "enum": [
        "master",
        "hls",
        "peaks",
        "thumbnails",
        "audio",
        "shots"
      ],
      "title": "ArtifactKind"
    },
    "ArtifactRecord": {
      "$id": "#/$defs/ArtifactRecord",
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageKey": {
          "type": "string",
          "minLength": 1
        },
        "storagePrefix": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "contentType",
        "kind",
        "metadata",
        "sizeBytes",
        "storageKey",
        "storagePrefix"
      ],
      "additionalProperties": false,
      "title": "ArtifactRecord"
    },
    "HelloInput": {
      "$id": "#/$defs/HelloInput",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Who to greet."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "name",
        "scope"
      ],
      "additionalProperties": false,
      "title": "HelloInput"
    },
    "HelloOutput": {
      "$id": "#/$defs/HelloOutput",
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string"
        },
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "Echoed from the input scope, never invented."
        },
        "workerHost": {
          "type": "string"
        },
        "workerLanguage": {
          "type": "string",
          "const": "python"
        }
      },
      "required": [
        "greeting",
        "organizationId",
        "workerHost",
        "workerLanguage"
      ],
      "additionalProperties": false,
      "title": "HelloOutput"
    },
    "IngestInput": {
      "$id": "#/$defs/IngestInput",
      "type": "object",
      "properties": {
        "artifactPrefix": {
          "type": "string",
          "minLength": 1,
          "description": "Prefix every derived artifact is written under; ends with '/'."
        },
        "masterKey": {
          "type": "string",
          "minLength": 1,
          "description": "The uploaded master's storage key."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "artifactPrefix",
        "masterKey",
        "scope",
        "sourceId"
      ],
      "additionalProperties": false,
      "title": "IngestInput"
    },
    "IngestOutput": {
      "$id": "#/$defs/IngestOutput",
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRecord"
          }
        },
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "Echoed from the input scope, never invented."
        },
        "probe": {
          "$ref": "#/$defs/ProbeResult"
        },
        "processingSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Wall-clock seconds the worker spent."
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "storageBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Sum of the artifact rows written."
        }
      },
      "required": [
        "artifacts",
        "organizationId",
        "probe",
        "processingSeconds",
        "sourceId",
        "storageBytes"
      ],
      "additionalProperties": false,
      "title": "IngestOutput"
    },
    "IngestStage": {
      "$id": "#/$defs/IngestStage",
      "type": "string",
      "enum": [
        "probe",
        "hls",
        "publish",
        "thumbnails",
        "audio",
        "peaks",
        "shots",
        "finalize"
      ],
      "title": "IngestStage"
    },
    "ProbeResult": {
      "$id": "#/$defs/ProbeResult",
      "type": "object",
      "properties": {
        "audioChannels": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "audioCodec": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "variableFrameRate": {
          "type": "boolean"
        },
        "videoCodec": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "audioChannels",
        "audioCodec",
        "durationMs",
        "fps",
        "height",
        "sizeBytes",
        "variableFrameRate",
        "videoCodec",
        "width"
      ],
      "additionalProperties": false,
      "title": "ProbeResult"
    },
    "Scope": {
      "$id": "#/$defs/Scope",
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "The organization every row is scoped to."
        },
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "The acting user inside that organization."
        }
      },
      "required": [
        "organizationId",
        "userId"
      ],
      "additionalProperties": false,
      "title": "Scope"
    },
    "TranscribeInput": {
      "$id": "#/$defs/TranscribeInput",
      "type": "object",
      "properties": {
        "artifactPrefix": {
          "type": "string",
          "minLength": 1,
          "description": "The source prefix; the transcript is written under it."
        },
        "audioKey": {
          "type": "string",
          "minLength": 1,
          "description": "The audio extract the provider reads; never the master."
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The probed duration; what the engine is metered against."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "artifactPrefix",
        "audioKey",
        "durationMs",
        "scope",
        "sourceId"
      ],
      "additionalProperties": false,
      "title": "TranscribeInput"
    },
    "TranscribeOutput": {
      "$id": "#/$defs/TranscribeOutput",
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "Echoed from the input scope, never invented."
        },
        "provider": {
          "$ref": "#/$defs/TranscriptProvider"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "speakerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageKey": {
          "type": "string",
          "minLength": 1
        },
        "wordCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "durationMs",
        "language",
        "organizationId",
        "provider",
        "revision",
        "sourceId",
        "speakerCount",
        "storageKey",
        "wordCount"
      ],
      "additionalProperties": false,
      "title": "TranscribeOutput"
    },
    "TranscriptProvider": {
      "$id": "#/$defs/TranscriptProvider",
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "model",
        "name",
        "version"
      ],
      "additionalProperties": false,
      "title": "TranscriptProvider"
    },
    "TranscriptStage": {
      "$id": "#/$defs/TranscriptStage",
      "type": "string",
      "enum": [
        "download",
        "model",
        "transcribe",
        "align",
        "diarize",
        "write",
        "retrying"
      ],
      "title": "TranscriptStage"
    },
    "TranscriptUtterance": {
      "$id": "#/$defs/TranscriptUtterance",
      "type": "object",
      "properties": {
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "endMs",
        "speaker",
        "startMs"
      ],
      "additionalProperties": false,
      "title": "TranscriptUtterance"
    },
    "TranscriptV1": {
      "$id": "#/$defs/TranscriptV1",
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "description": "The detected language code, so a wrong guess is visible."
        },
        "provider": {
          "$ref": "#/$defs/TranscriptProvider"
        },
        "speakers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every speaker id used by a word, in first-appearance order."
        },
        "utterances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptUtterance"
          }
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptWord"
          }
        }
      },
      "required": [
        "durationMs",
        "language",
        "provider",
        "speakers",
        "utterances",
        "version",
        "words"
      ],
      "additionalProperties": false,
      "title": "TranscriptV1"
    },
    "TranscriptWord": {
      "$id": "#/$defs/TranscriptWord",
      "type": "object",
      "properties": {
        "confidence": {
          "description": "Alignment score, or null when the provider gave none.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/WordTiming"
        }
      },
      "required": [
        "confidence",
        "endMs",
        "speaker",
        "startMs",
        "text",
        "timing"
      ],
      "additionalProperties": false,
      "title": "TranscriptWord"
    },
    "WordTiming": {
      "$id": "#/$defs/WordTiming",
      "type": "string",
      "enum": [
        "aligned",
        "interpolated"
      ],
      "title": "WordTiming"
    }
  },
  "$id": "WordTiming.json",
  "$ref": "#/$defs/WordTiming",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
