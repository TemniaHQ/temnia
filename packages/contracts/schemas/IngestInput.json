{
  "$defs": {
    "ArtifactKind": {
      "$id": "#/$defs/ArtifactKind",
      "type": "string",
      "enum": [
        "master",
        "hls",
        "peaks",
        "thumbnails",
        "audio",
        "shots"
      ],
      "title": "ArtifactKind"
    },
    "ArtifactRecord": {
      "$id": "#/$defs/ArtifactRecord",
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageKey": {
          "type": "string",
          "minLength": 1
        },
        "storagePrefix": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "contentType",
        "kind",
        "metadata",
        "sizeBytes",
        "storageKey",
        "storagePrefix"
      ],
      "additionalProperties": false,
      "title": "ArtifactRecord"
    },
    "HelloInput": {
      "$id": "#/$defs/HelloInput",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Who to greet."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "name",
        "scope"
      ],
      "additionalProperties": false,
      "title": "HelloInput"
    },
    "HelloOutput": {
      "$id": "#/$defs/HelloOutput",
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string"
        },
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "Echoed from the input scope, never invented."
        },
        "workerHost": {
          "type": "string"
        },
        "workerLanguage": {
          "type": "string",
          "const": "python"
        }
      },
      "required": [
        "greeting",
        "organizationId",
        "workerHost",
        "workerLanguage"
      ],
      "additionalProperties": false,
      "title": "HelloOutput"
    },
    "IngestInput": {
      "$id": "#/$defs/IngestInput",
      "type": "object",
      "properties": {
        "artifactPrefix": {
          "type": "string",
          "minLength": 1,
          "description": "Prefix every derived artifact is written under; ends with '/'."
        },
        "masterKey": {
          "type": "string",
          "minLength": 1,
          "description": "The uploaded master's storage key."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "artifactPrefix",
        "masterKey",
        "scope",
        "sourceId"
      ],
      "additionalProperties": false,
      "title": "IngestInput"
    }
  },
  "$id": "IngestInput.json",
  "$ref": "#/$defs/IngestInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
