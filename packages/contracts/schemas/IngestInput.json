{
  "$defs": {
    "IngestInput": {
      "$id": "#/$defs/IngestInput",
      "type": "object",
      "properties": {
        "artifactPrefix": {
          "type": "string",
          "minLength": 1,
          "description": "Prefix every derived artifact is written under; ends with '/'."
        },
        "masterKey": {
          "type": "string",
          "minLength": 1,
          "description": "The uploaded master's storage key."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "artifactPrefix",
        "masterKey",
        "scope",
        "sourceId"
      ],
      "additionalProperties": false,
      "title": "IngestInput"
    },
    "Scope": {
      "$id": "#/$defs/Scope",
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "The organization every row is scoped to."
        },
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "The acting user inside that organization."
        }
      },
      "required": [
        "organizationId",
        "userId"
      ],
      "additionalProperties": false,
      "title": "Scope"
    }
  },
  "$id": "IngestInput.json",
  "$ref": "#/$defs/IngestInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
