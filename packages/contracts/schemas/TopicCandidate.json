{
  "$defs": {
    "TopicCandidate": {
      "$id": "#/$defs/TopicCandidate",
      "type": "object",
      "properties": {
        "completionSpans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "coreSpans": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "firstSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lastSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "meaningChangingFollowups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "requiredContextSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSentenceSpan"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "completionSpans",
        "coreSpans",
        "firstSentenceId",
        "id",
        "lastSentenceId",
        "meaningChangingFollowups",
        "purpose",
        "reason",
        "requiredContextSpans",
        "title"
      ],
      "additionalProperties": false,
      "title": "TopicCandidate"
    },
    "TopicSentenceSpan": {
      "$id": "#/$defs/TopicSentenceSpan",
      "type": "object",
      "properties": {
        "firstSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "lastSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "firstSentenceId",
        "lastSentenceId"
      ],
      "additionalProperties": false,
      "title": "TopicSentenceSpan"
    }
  },
  "$id": "TopicCandidate.json",
  "$ref": "#/$defs/TopicCandidate",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
