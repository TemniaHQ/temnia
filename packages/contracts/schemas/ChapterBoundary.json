{
  "$defs": {
    "ChapterBoundary": {
      "$id": "#/$defs/ChapterBoundary",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiresReview": {
          "type": "boolean"
        },
        "time": {
          "$ref": "#/$defs/RationalTime"
        },
        "timeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "candidateId",
        "id",
        "reasons",
        "requiresReview",
        "time",
        "timeMs"
      ],
      "additionalProperties": false,
      "title": "ChapterBoundary"
    },
    "RationalTime": {
      "$id": "#/$defs/RationalTime",
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "denominator",
        "numerator"
      ],
      "additionalProperties": false,
      "title": "RationalTime"
    }
  },
  "$id": "ChapterBoundary.json",
  "$ref": "#/$defs/ChapterBoundary",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
