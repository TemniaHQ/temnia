{
  "$defs": {
    "Scope": {
      "$id": "#/$defs/Scope",
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "description": "The organization every row is scoped to."
        },
        "userId": {
          "type": "string",
          "format": "uuid",
          "description": "The acting user inside that organization."
        }
      },
      "required": [
        "organizationId",
        "userId"
      ],
      "additionalProperties": false,
      "title": "Scope"
    },
    "TranscribeInput": {
      "$id": "#/$defs/TranscribeInput",
      "type": "object",
      "properties": {
        "artifactPrefix": {
          "type": "string",
          "minLength": 1,
          "description": "The source prefix; the transcript is written under it."
        },
        "audioKey": {
          "type": "string",
          "minLength": 1,
          "description": "The audio extract the provider reads; never the master."
        },
        "durationMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The probed duration; what the engine is metered against."
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "artifactPrefix",
        "audioKey",
        "durationMs",
        "scope",
        "sourceId"
      ],
      "additionalProperties": false,
      "title": "TranscribeInput"
    }
  },
  "$id": "TranscribeInput.json",
  "$ref": "#/$defs/TranscribeInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
