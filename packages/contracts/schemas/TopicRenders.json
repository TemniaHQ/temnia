{
  "$defs": {
    "HarnessArtifactKind": {
      "$id": "#/$defs/HarnessArtifactKind",
      "type": "string",
      "enum": [
        "evidence",
        "proposal",
        "model_response",
        "edit",
        "render",
        "checks",
        "export",
        "speech_checkpoint",
        "speech_assignment"
      ],
      "title": "HarnessArtifactKind"
    },
    "HarnessArtifactRef": {
      "$id": "#/$defs/HarnessArtifactRef",
      "type": "object",
      "properties": {
        "fingerprint": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "#/$defs/HarnessArtifactKind"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "fingerprint",
        "id",
        "kind",
        "sha256",
        "sizeBytes",
        "storageKey"
      ],
      "additionalProperties": false,
      "title": "HarnessArtifactRef"
    },
    "TopicRenderedVideo": {
      "$id": "#/$defs/TopicRenderedVideo",
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "descriptor": {
          "$ref": "#/$defs/HarnessArtifactRef"
        },
        "execution": {
          "$ref": "#/$defs/HarnessArtifactRef"
        }
      },
      "required": [
        "candidateId",
        "descriptor",
        "execution"
      ],
      "additionalProperties": false,
      "title": "TopicRenderedVideo"
    },
    "TopicRenders": {
      "$id": "#/$defs/TopicRenders",
      "type": "object",
      "properties": {
        "editSha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "format": {
          "type": "string",
          "const": "topic-renders/1"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "videos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicRenderedVideo"
          }
        }
      },
      "required": [
        "editSha256",
        "format",
        "runId",
        "videos"
      ],
      "additionalProperties": false,
      "title": "TopicRenders"
    }
  },
  "$id": "TopicRenders.json",
  "$ref": "#/$defs/TopicRenders",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
