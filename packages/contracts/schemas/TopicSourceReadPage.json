{
  "$defs": {
    "TopicSourceIndexSentence": {
      "$id": "#/$defs/TopicSourceIndexSentence",
      "type": "object",
      "properties": {
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "speakers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "endMs",
        "id",
        "speakers",
        "startMs",
        "text"
      ],
      "additionalProperties": false,
      "title": "TopicSourceIndexSentence"
    },
    "TopicSourceReadPage": {
      "$id": "#/$defs/TopicSourceReadPage",
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "indexSha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "nextSentenceId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "sentences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSourceIndexSentence"
          }
        },
        "fragments": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSourceSentenceFragment"
          }
        },
        "nextCharacterOffset": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "complete",
        "indexSha256",
        "nextSentenceId",
        "sentences",
        "fragments",
        "nextCharacterOffset"
      ],
      "additionalProperties": false,
      "title": "TopicSourceReadPage"
    },
    "TopicSourceSentenceFragment": {
      "$id": "#/$defs/TopicSourceSentenceFragment",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "startCharacter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endCharacter": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "totalCharacters": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sentenceId",
        "startCharacter",
        "endCharacter",
        "totalCharacters",
        "text"
      ],
      "additionalProperties": false,
      "title": "TopicSourceSentenceFragment"
    }
  },
  "$id": "TopicSourceReadPage.json",
  "$ref": "#/$defs/TopicSourceReadPage",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
