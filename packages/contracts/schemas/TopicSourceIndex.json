{
  "$defs": {
    "TopicSourceIndex": {
      "$id": "#/$defs/TopicSourceIndex",
      "type": "object",
      "properties": {
        "embeddingDimensions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "embeddingModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "embeddingRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidenceSha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "type": "string"
        },
        "format": {
          "type": "string",
          "const": "topic-source-index/2"
        },
        "nodes": {
          "minItems": 3,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSourceIndexNode"
          }
        },
        "regionMaxCharacters": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "regionMaxSentences": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "rootNodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sectionMaxRegions": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sentences": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicSourceIndexSentence"
          }
        },
        "sourceId": {
          "type": "string",
          "format": "uuid"
        },
        "transcriptId": {
          "type": "string",
          "format": "uuid"
        },
        "transcriptRevision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "embeddingDimensions",
        "embeddingModel",
        "embeddingRevision",
        "evidenceSha256",
        "format",
        "nodes",
        "regionMaxCharacters",
        "regionMaxSentences",
        "rootNodeId",
        "sectionMaxRegions",
        "sentences",
        "sourceId",
        "transcriptId",
        "transcriptRevision"
      ],
      "additionalProperties": false,
      "title": "TopicSourceIndex"
    },
    "TopicSourceIndexNode": {
      "$id": "#/$defs/TopicSourceIndexNode",
      "type": "object",
      "properties": {
        "childIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "firstSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "episode",
            "section",
            "region"
          ]
        },
        "lastSentenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "preview": {
          "type": "string"
        },
        "sentenceCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "childIds",
        "embedding",
        "endMs",
        "firstSentenceId",
        "id",
        "keywords",
        "kind",
        "lastSentenceId",
        "ordinal",
        "parentId",
        "preview",
        "sentenceCount",
        "startMs"
      ],
      "additionalProperties": false,
      "title": "TopicSourceIndexNode"
    },
    "TopicSourceIndexSentence": {
      "$id": "#/$defs/TopicSourceIndexSentence",
      "type": "object",
      "properties": {
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "speakers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "endMs",
        "id",
        "speakers",
        "startMs",
        "text"
      ],
      "additionalProperties": false,
      "title": "TopicSourceIndexSentence"
    }
  },
  "$id": "TopicSourceIndex.json",
  "$ref": "#/$defs/TopicSourceIndex",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
