{
  "$defs": {
    "TranscriptWord": {
      "$id": "#/$defs/TranscriptWord",
      "type": "object",
      "properties": {
        "confidence": {
          "description": "Alignment score, or null when the provider gave none.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "endMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/WordTiming"
        }
      },
      "required": [
        "confidence",
        "endMs",
        "speaker",
        "startMs",
        "text",
        "timing"
      ],
      "additionalProperties": false,
      "title": "TranscriptWord"
    },
    "WordTiming": {
      "$id": "#/$defs/WordTiming",
      "type": "string",
      "enum": [
        "aligned",
        "interpolated"
      ],
      "title": "WordTiming"
    }
  },
  "$id": "TranscriptWord.json",
  "$ref": "#/$defs/TranscriptWord",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
