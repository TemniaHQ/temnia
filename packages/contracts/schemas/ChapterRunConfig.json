{
  "$defs": {
    "ChapterRunConfig": {
      "$id": "#/$defs/ChapterRunConfig",
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "recorded",
            "gateway"
          ]
        },
        "evidenceWindowSentences": {
          "default": 80,
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "maxDispatches": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "default": 8192,
          "type": "integer",
          "minimum": 256,
          "maximum": 65536
        },
        "maxRenderConcurrency": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "maxRepairs": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "routeSnapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "backend",
        "evidenceWindowSentences",
        "maxDispatches",
        "maxOutputTokens",
        "maxRenderConcurrency",
        "maxRepairs",
        "routeSnapshotId"
      ],
      "additionalProperties": false,
      "title": "ChapterRunConfig"
    }
  },
  "$id": "ChapterRunConfig.json",
  "$ref": "#/$defs/ChapterRunConfig",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
