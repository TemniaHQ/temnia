{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/.venv",
      // Design prototypes and generated docs assets are not source code.
      "!docs",
      // Vendored shadcn registry output: regenerated by the CLI, never hand-maintained.
      "!apps/web/components/ui",
      // Generated: JSON Schema from Zod, drizzle-kit migrations. Their generators own the formatting.
      "!packages/contracts/schemas",
      "!packages/db/drizzle",
      // The frozen legacy oracle: a copy, not source. Its formatting is the
      // legacy's, and reformatting it would put the parity fixtures and the
      // code they were dumped from out of step.
      "!tools/legacy-reference/lib",
      // Recorded engine responses, read only by Python. They are kept exactly
      // as the engine emits them, and Python's json writes the bare NaN a
      // whisperx alignment score can be, which is not JSON biome can parse.
      "!apps/pipeline/tests/fixtures"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        // The React Compiler is on (next.config.ts); it memoises handlers, so
        // a function defined in the component body is a stable prop already.
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      // A package entry point re-exports its modules on purpose.
      "includes": ["packages/*/src/index.ts", "apps/web/lib/utils.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    }
  ]
}
